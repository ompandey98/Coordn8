{
 "schema": 1,
 "id": "ops-console",
 "name": "Ops Console",
 "base": "dark",
 "palette_family": "foundry-signal",
 "mood": [
  "precise",
  "terse",
  "technical",
  "alert",
  "fast"
 ],
 "use_when": [
  "infrastructure, deployment, observability or incident walkthroughs",
  "command-line tools and pipelines",
  "senior engineers who want density"
 ],
 "avoid_when": [
  "patients or a general public audience",
  "children",
  "emotional storytelling"
 ],
 "signals": {
  "for": [
   "infra",
   "infrastructure",
   "devops",
   "deploy",
   "deployment",
   "kubernetes",
   "cluster",
   "pipeline",
   "observability",
   "monitoring",
   "incident",
   "latency",
   "cli",
   "terminal",
   "server",
   "cloud",
   "network",
   "logs",
   "sre",
   "queue",
   "backend"
  ],
  "against": [
   "kids",
   "children",
   "patient",
   "patients",
   "wellness",
   "storybook",
   "fashion"
  ]
 },
 "palette": {
  "family": "ops-console",
  "roles": {
   "paper": "#f2f5f3",
   "ink": "#14201b",
   "muted": "#4b5d55",
   "accent": "#4b7300",
   "link": "#1d5d96",
   "positive": "#1c7446",
   "negative": "#b2352b",
   "warning": "#8a5a00",
   "deterministic": "#1d5d96",
   "model-judgement": "#6c3fb8",
   "data-field": "#1c7446",
   "vision": "#8a5a00"
  },
  "dark": {
   "paper": "#0e1513",
   "ink": "#e3ece7",
   "muted": "#9db0a7",
   "accent": "#b9e35a",
   "link": "#7cc4f0",
   "positive": "#5fd39a",
   "negative": "#ff8a7a",
   "warning": "#f2c35b",
   "deterministic": "#7cc4f0",
   "model-judgement": "#c9a2ff",
   "data-field": "#5fd39a",
   "vision": "#f2c35b"
  },
  "note": "the kit's own built-in skin (light in roles, dark in dark); when the Palette Director has chosen a palette for the build, that palette replaces this one"
 },
 "theme": {
  "family": {
   "display": "'SF Mono', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
   "body": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
   "mono": "'SF Mono', Menlo, Consolas, 'DejaVu Sans Mono', monospace"
  },
  "weights": {
   "display": 600,
   "body": 450,
   "strong": 650
  },
  "scale": {
   "title": 56,
   "h1": 42,
   "h2": 34,
   "body": 30,
   "caption": 28,
   "label": 28
  },
  "page_scale": {
   "title": 36,
   "h1": 26,
   "h2": 20,
   "body": 16,
   "caption": 14,
   "small": 13
  },
  "line_height": 1.35,
  "tracking_em": -0.005,
  "numerals": "tabular everywhere",
  "vendorable": [
   {
    "name": "JetBrains Mono",
    "licence": "OFL-1.1",
    "shipped": false,
    "note": "optional; the system mono stack is the default"
   }
  ]
 },
 "stage": {
  "background": {
   "treatment": "scanline-grid",
   "base_role": "paper",
   "texture": {
    "kind": "grid",
    "alpha": 0.05,
    "spacing_px": 48
   },
   "vignette": 0.0
  },
  "grid": {
   "columns": 12,
   "gutter_px": 24,
   "margin_px": 96,
   "baseline_px": 4
  },
  "safe_area": {
   "x_pct": 5,
   "y_pct": 5
  },
  "radius": {
   "card": 4,
   "chip": 3,
   "node": 4
  },
  "stroke": {
   "hairline": 1,
   "connector": 2.5,
   "emphasis": 4
  },
  "depth": {
   "shadow": "none",
   "glow": 0.0
  }
 },
 "props": {
  "card": {
   "fill": {
    "role": "ink",
    "alpha": 0.05
   },
   "border": {
    "role": "muted",
    "alpha": 0.45
   },
   "border_width": 1,
   "radius": 4,
   "pad_px": 20,
   "shadow": "none",
   "header_bar": true
  },
  "chip": {
   "fill": {
    "role": "paper"
   },
   "border": {
    "role": "accent"
   },
   "text": {
    "role": "accent"
   },
   "shape": "bracket",
   "radius": 3,
   "weight": 600
  },
  "node": {
   "fill": {
    "role": "ink",
    "alpha": 0.06
   },
   "border": {
    "role": "link",
    "alpha": 0.8
   },
   "border_width": 1.5,
   "radius": 4,
   "text_px": 28
  },
  "connector": {
   "stroke": {
    "role": "link",
    "alpha": 0.85
   },
   "width": 2.5,
   "dash": [
    10,
    6
   ],
   "arrow": "triangle",
   "routing": "orthogonal",
   "draw_on": true,
   "flow": "marching-dashes"
  },
  "callout": {
   "style": "bracket-label",
   "stroke": {
    "role": "accent"
   },
   "width": 2,
   "label": {
    "role": "accent"
   },
   "leader": "elbow"
  }
 },
 "charts": {
  "series": {
   "role": "ink",
   "steps": [
    1.0,
    0.68,
    0.46
   ]
  },
  "highlight": {
   "role": "accent",
   "max": 1
  },
  "gridline": {
   "stroke": {
    "role": "muted",
    "alpha": 0.2
   },
   "width": 1,
   "dash": [
    1,
    4
   ]
  },
  "axis": {
   "stroke": {
    "role": "muted"
   },
   "width": 1
  },
  "label": {
   "role": "muted",
   "size_px": 28,
   "font": "mono"
  },
  "increase_decrease": {
   "increase": "filled bar",
   "decrease": "hatched bar"
  },
  "draw_on": false
 },
 "motion": {
  "ease": "cubic-bezier(.2,0,0,1)",
  "enter_ms": 260,
  "exit_ms": 180,
  "stagger_ms": 45,
  "lead_ms": 80,
  "hold_min_ms": 700,
  "entrance": {
   "kind": "wipe-in",
   "opacity_from": 0,
   "translate_x_px": -12,
   "clip": "left-to-right",
   "blur_px": 0
  },
  "exit": {
   "kind": "snap-out",
   "opacity_to": 0
  }
 },
 "transitions": [
  {
   "id": "cut-on-beat",
   "use": "within-section",
   "ms": 0,
   "on_beat": true
  },
  {
   "id": "wipe-right",
   "use": "section",
   "ms": 240,
   "mask": "wipe-right",
   "via_role": "accent"
  },
  {
   "id": "morph",
   "use": "within-section",
   "ms": 300,
   "morph": true
  }
 ],
 "continuity": {
  "prefer": "morph",
  "first_second_anchor": "the system map is already drawn at frame 0; only the focus moves"
 },
 "caption_style": {
  "font_px": 28,
  "weight": 500,
  "max_lines": 2,
  "max_marks": 2,
  "overflow": "truncate",
  "position": "lower-left",
  "width_pct": 64,
  "text": {
   "role": "ink"
  },
  "scrim": {
   "role": "paper",
   "alpha": 0.9,
   "radius_px": 3,
   "pad_px": 18
  },
  "reveal": "word",
  "dim_previous": true,
  "marks": {
   "good": {
    "role": "positive",
    "styles": [
     "box"
    ]
   },
   "bad": {
    "role": "negative",
    "styles": [
     "strike-through"
    ]
   },
   "key": {
    "role": "accent",
    "styles": [
     "underline",
     "weight-700"
    ]
   }
  },
  "markup": "⟦good:…⟧ ⟦bad:…⟧ ⟦key:…⟧ — spoken form strips the marks"
 },
 "do": [
  "keep the whole system on screen and move a highlight through it",
  "show numbers in tabular figures so columns line up while they count",
  "cut on the beat inside a section; wipe only at a section change"
 ],
 "dont": [
  "no soft blurs or long dissolves — they read as slow",
  "no glow effects; contrast does the work",
  "never recite log lines aloud — show them, say what they mean"
 ]
}
