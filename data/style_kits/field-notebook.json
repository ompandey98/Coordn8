{
 "schema": 1,
 "id": "field-notebook",
 "name": "Field Notebook",
 "base": "light",
 "palette_family": "terracotta-press",
 "mood": [
  "calm",
  "curious",
  "careful",
  "scholarly",
  "warm"
 ],
 "use_when": [
  "a method or research finding explained step by step",
  "history or reasoning behind a design",
  "mixed audiences who read closely"
 ],
 "avoid_when": [
  "product launch hype",
  "very young children",
  "fast-paced operations dashboards"
 ],
 "signals": {
  "for": [
   "research",
   "method",
   "science",
   "history",
   "paper",
   "study",
   "algorithm",
   "proof",
   "reasoning",
   "academic",
   "analysis",
   "notebook",
   "experiment",
   "learning",
   "statistics"
  ],
  "against": [
   "launch",
   "hype",
   "kids",
   "children",
   "toddler",
   "marketing",
   "incident"
  ]
 },
 "palette": {
  "family": "field-notebook",
  "roles": {
   "paper": "#f7f3ea",
   "ink": "#23211c",
   "muted": "#5c574c",
   "accent": "#8a5d00",
   "link": "#1f5a8c",
   "positive": "#2f6e3a",
   "negative": "#a3283d",
   "warning": "#a1460b",
   "deterministic": "#1f5a8c",
   "model-judgement": "#6a3f9a",
   "data-field": "#2f6e3a",
   "vision": "#a1460b"
  },
  "dark": {
   "paper": "#1b1a16",
   "ink": "#eee8da",
   "muted": "#b3ab9b",
   "accent": "#e0b45a",
   "link": "#8fbbe3",
   "positive": "#8acb95",
   "negative": "#f08d9c",
   "warning": "#f0a067",
   "deterministic": "#8fbbe3",
   "model-judgement": "#c6a5ec",
   "data-field": "#8acb95",
   "vision": "#f0a067"
  },
  "note": "the kit's own built-in skin (light in roles, dark in dark); when the Palette Director has chosen a palette for the build, that palette replaces this one"
 },
 "theme": {
  "family": {
   "display": "'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif",
   "body": "Charter, 'Bitstream Charter', 'Sitka Text', Cambria, Georgia, serif",
   "mono": "Menlo, Consolas, 'DejaVu Sans Mono', monospace"
  },
  "weights": {
   "display": 600,
   "body": 400,
   "strong": 700
  },
  "scale": {
   "title": 64,
   "h1": 46,
   "h2": 36,
   "body": 32,
   "caption": 30,
   "label": 28
  },
  "page_scale": {
   "title": 44,
   "h1": 32,
   "h2": 24,
   "body": 18,
   "caption": 15,
   "small": 14
  },
  "line_height": 1.45,
  "tracking_em": 0.0,
  "numerals": "oldstyle in prose, lining in figures",
  "vendorable": [
   {
    "name": "Source Serif 4",
    "licence": "OFL-1.1",
    "shipped": false,
    "note": "optional upgrade for the body face; system stack works offline"
   }
  ]
 },
 "stage": {
  "background": {
   "treatment": "paper-grain",
   "base_role": "paper",
   "texture": {
    "kind": "grain",
    "alpha": 0.035
   },
   "vignette": 0.06
  },
  "grid": {
   "columns": 12,
   "gutter_px": 32,
   "margin_px": 112,
   "baseline_px": 8
  },
  "safe_area": {
   "x_pct": 6,
   "y_pct": 6
  },
  "radius": {
   "card": 10,
   "chip": 6,
   "node": 8
  },
  "stroke": {
   "hairline": 1.5,
   "connector": 3,
   "emphasis": 4.5
  },
  "depth": {
   "shadow": "soft",
   "shadow_alpha": 0.08,
   "offset_px": 6
  }
 },
 "props": {
  "card": {
   "fill": {
    "role": "ink",
    "alpha": 0.035
   },
   "border": {
    "role": "ink",
    "alpha": 0.16
   },
   "border_width": 1.5,
   "radius": 10,
   "pad_px": 26,
   "shadow": "soft"
  },
  "chip": {
   "fill": {
    "role": "accent",
    "alpha": 0.12
   },
   "text": {
    "role": "ink"
   },
   "shape": "tag",
   "radius": 6,
   "weight": 600
  },
  "node": {
   "fill": {
    "role": "paper"
   },
   "border": {
    "role": "ink",
    "alpha": 0.55
   },
   "border_width": 2,
   "radius": 8,
   "text_px": 30
  },
  "connector": {
   "stroke": {
    "role": "muted"
   },
   "width": 3,
   "dash": [],
   "arrow": "open-chevron",
   "routing": "orthogonal",
   "draw_on": true
  },
  "callout": {
   "style": "margin-note",
   "stroke": {
    "role": "accent"
   },
   "width": 2.5,
   "label": {
    "role": "ink"
   },
   "leader": "curved"
  }
 },
 "charts": {
  "series": {
   "role": "ink",
   "steps": [
    1.0,
    0.72,
    0.5,
    0.32
   ]
  },
  "highlight": {
   "role": "accent",
   "max": 1
  },
  "gridline": {
   "stroke": {
    "role": "muted",
    "alpha": 0.25
   },
   "width": 1,
   "dash": [
    2,
    6
   ]
  },
  "axis": {
   "stroke": {
    "role": "muted"
   },
   "width": 1.5
  },
  "label": {
   "role": "muted",
   "size_px": 28
  },
  "increase_decrease": {
   "increase": "solid fill",
   "decrease": "outline only"
  },
  "draw_on": true
 },
 "motion": {
  "ease": "cubic-bezier(.25,.8,.25,1)",
  "enter_ms": 480,
  "exit_ms": 320,
  "stagger_ms": 110,
  "lead_ms": 120,
  "hold_min_ms": 900,
  "entrance": {
   "kind": "settle",
   "opacity_from": 0,
   "translate_y_px": 18,
   "scale_from": 1,
   "blur_px": 0
  },
  "exit": {
   "kind": "lift-away",
   "opacity_to": 0,
   "translate_y_px": -8
  }
 },
 "transitions": [
  {
   "id": "morph",
   "use": "within-section",
   "ms": 520,
   "morph": true,
   "note": "the same element moves to its new place"
  },
  {
   "id": "dissolve",
   "use": "within-section",
   "ms": 420,
   "blend": "crossfade"
  },
  {
   "id": "page-push",
   "use": "section",
   "ms": 640,
   "blend": "none",
   "move": {
    "x": -1,
    "y": 0
   },
   "ease": "cubic-bezier(.45,0,.25,1)"
  }
 ],
 "continuity": {
  "prefer": "morph",
  "first_second_anchor": "the question being answered is written on screen from frame 0"
 },
 "caption_style": {
  "font_px": 30,
  "weight": 600,
  "max_lines": 2,
  "max_marks": 2,
  "overflow": "truncate",
  "position": "bottom-center",
  "width_pct": 72,
  "text": {
   "role": "ink"
  },
  "scrim": {
   "role": "paper",
   "alpha": 0.88,
   "radius_px": 10,
   "pad_px": 18
  },
  "reveal": "phrase",
  "dim_previous": true,
  "marks": {
   "good": {
    "role": "positive",
    "styles": [
     "underline"
    ]
   },
   "bad": {
    "role": "negative",
    "styles": [
     "strike-through"
    ]
   },
   "key": {
    "role": "accent",
    "styles": [
     "weight-700",
     "small-caps"
    ]
   }
  },
  "markup": "⟦good:…⟧ ⟦bad:…⟧ ⟦key:…⟧ — spoken form strips the marks"
 },
 "do": [
  "let one annotated figure carry each idea, with margin notes pointing at the exact part",
  "draw lines on, left to right, as the sentence reaches them",
  "keep the accent for the single conclusion of each frame"
 ],
 "dont": [
  "no confetti, bounce or overshoot — the tone is careful",
  "no more than one accent element per frame",
  "do not set body text in the display face"
 ]
}
