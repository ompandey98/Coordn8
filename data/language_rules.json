{
 "schema": 1,
 "doctrine": "Register profiles and word lists for scripts/gates/check_language.py, check_terms.py and check_truth.py. An original implementation of the MEASURABLE rules of the ASD-STE100 controlled-English standard (sentence length, one instruction per sentence, imperative steps, condition before command, noun clusters, active voice, no semicolons, no Latin abbreviations, counting rules, paragraph length, safety-instruction form). The standard's approved-word dictionary is NOT included; a local word list can be supplied with --dictionary. Profiles are a menu of starting points, never a fence: an agent may define an invented profile (`invented:<name>`, based on any profile, with its own limits and a reason). The checkers REPORT; they never rewrite any text, and narration findings are notes only (the standard is not written for speech, so contractions and phrasal verbs are allowed there).",
 "profiles": {
  "procedure": {
   "use_for": "on-screen steps a reader carries out, one per sentence",
   "severity": "review",
   "max_words": 20,
   "max_sentences_per_paragraph": null,
   "rules": [
    "length",
    "one_instruction",
    "imperative",
    "condition_first",
    "no_semicolon",
    "no_latin_abbreviation"
   ],
   "note_rules": [
    "noun_cluster",
    "filler"
   ]
  },
  "description": {
   "use_for": "page prose and captions",
   "severity": "review",
   "max_words": 25,
   "max_sentences_per_paragraph": 6,
   "rules": [
    "length",
    "paragraph_length",
    "active_voice",
    "noun_cluster",
    "no_semicolon"
   ],
   "note_rules": [
    "one_idea",
    "no_latin_abbreviation",
    "filler"
   ]
  },
  "warning": {
   "use_for": "safety instructions: a WARNING (risk to people or data) or a CAUTION (risk to equipment or work)",
   "severity": "review",
   "max_words": 20,
   "max_sentences_per_paragraph": null,
   "rules": [
    "signal_word",
    "condition_first",
    "states_risk",
    "length",
    "no_semicolon",
    "no_latin_abbreviation"
   ],
   "note_rules": [
    "noun_cluster"
   ]
  },
  "narration": {
   "use_for": "the spoken voice track — REPORT ONLY, never fails, never rewritten",
   "severity": "note",
   "max_words": 25,
   "max_sentences_per_paragraph": null,
   "rules": [
    "length",
    "one_idea",
    "active_voice",
    "one_term"
   ],
   "note_rules": [],
   "allowed": [
    "contractions",
    "phrasal verbs",
    "second-person you",
    "semicolon-free by nature (not checked)"
   ]
  }
 },
 "counting": {
  "doctrine": "Counted after masking: a hyphenated word is one word; a parenthesis (the bracket and everything inside it) is one word; a code span, a [[path:line]] chip, a URL and a number with its unit symbol are one word each. Dashes separate words.",
  "parenthesis_counts_as": 1,
  "hyphenated_word_counts_as": 1
 },
 "one_idea": {
  "doctrine": "A sentence carries more than one idea when three or more clauses are joined; two clause joints is the threshold.",
  "max_clause_joints": 1,
  "joints": [
   ", and ",
   ", but ",
   ", so ",
   ", while ",
   ", whereas ",
   ", which ",
   " and then ",
   ", then ",
   " — and ",
   " whereas ",
   " while also "
  ]
 },
