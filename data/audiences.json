   "sentence_words_max": 16,
   "jargon": "introduce a proper term with its meaning in the same sentence",
   "depth": "core idea plus one layer of how",
   "entry_point": "something from their phone, games or school",
   "analogy_sources": [
    "phones and apps",
    "social media",
    "gaming",
    "school",
    "sports",
    "music"
   ],
   "video_pace": "medium-fast; a hook in the first seconds"
  },
  {
   "id": "lay-adult",
   "order": 2,
   "label": "adult without a technical background",
   "register_shift": "patient, warm, conversational; respectful, never condescending",
   "sentence_words_max": 18,
   "jargon": "only terms they will meet again, each defined in the same breath",
   "depth": "what it does for them and why it matters",
   "entry_point": "an everyday situation they already know",
