    "household routines",
    "shopping and queues",
    "post and parcels",
    "kitchens and recipes",
    "familiar apps"
   ],
   "video_pace": "medium; stakes before machinery"
  },
  {
   "id": "informed-adult",
   "order": 3,
   "label": "professional outside this field",
   "register_shift": "confident and clear; respects their intelligence while bridging the gap",
   "sentence_words_max": 22,
   "jargon": "standard terms with a short gloss on first use",
   "depth": "the mental model plus the parts that change decisions",
   "entry_point": "the problem and its impact",
   "analogy_sources": [
    "work processes",
    "logistics",
    "money and budgets",
    "everyday systems"
   ],
   "video_pace": "medium"
  },
  {
   "id": "practitioner",
   "order": 4,
   "label": "works in the field day to day",
   "register_shift": "precise colleague; plain over pompous",
   "sentence_words_max": 25,
   "jargon": "field terms kept; this project's own names are defined",
   "depth": "full, with trade-offs where they bite",
   "entry_point": "the real call path and its job",
   "analogy_sources": [
    "systems and patterns they already know"
   ],
   "video_pace": "medium-fast"
  },
  {
   "id": "specialist",
   "order": 5,
   "label": "deep expert in the subject's field",
   "register_shift": "precise, dense, respects their time; keep the field's vocabulary",
   "sentence_words_max": 28,
