#!/bin/sh
# Coordn8 launcher: runs the Node CLI that sits next to this file.
# On the Bash tool's PATH while the Coordn8 Claude Code plugin is enabled; works the
# same when called by path, through a symlink, or from any working directory.
self=$0
case $self in
  */*) ;;
  *) self=$(command -v -- "$self" 2>/dev/null || printf '%s' "$self") ;;
esac
# follow symlinks so the CLI is found next to the real file, not the link
n=0
while [ -L "$self" ] && [ "$n" -lt 32 ]; do
  link=$(readlink -- "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
  n=$((n + 1))
done
dir=$(CDPATH='' cd -- "$(dirname -- "$self")" 2>/dev/null && pwd -P)
cli="$dir/coordn8.js"
if [ ! -f "$cli" ]; then
  echo "[coordn8] cannot find coordn8.js next to $self; reinstall the package or the plugin." >&2
  exit 2
fi
if ! command -v node >/dev/null 2>&1; then
  echo "[coordn8] Node.js was not found on PATH. Install Node.js 14 or newer, then run this again." >&2
  exit 127
fi
exec node "$cli" "$@"
