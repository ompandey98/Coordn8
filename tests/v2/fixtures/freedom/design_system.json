    "fill": {
     "role": "accent",
     "alpha": 0.12
    },
    "text": {
     "role": "ink"
    },
    "shape": "pill",
    "radius": 999,
    "weight": 600
   },
   "node": {
    "fill": {
     "role": "accent",
