   "axis": {
    "stroke": {
     "role": "muted"
    },
    "width": 2
   },
   "label": {
    "role": "muted",
    "size_px": 30
   },
   "increase_decrease": {
    "increase": "solid with \u25b2",
    "decrease": "outline with \u25bc"
   },
   "draw_on": true
  },
  "motion": {
   "ease": "cubic-bezier(.33,0,.15,1)",
   "enter_ms": 640,
   "exit_ms": 420,
   "stagger_ms": 150,
   "lead_ms": 150,
   "hold_min_ms": 1400,
   "entrance": {
    "kind": "fade",
    "opacity_from": 0,
    "translate_y_px": 8,
    "blur_px": 0
   },
   "exit": {
    "kind": "fade",
    "opacity_to": 0
   }
  },
  "transitions": [
   {
    "id": "dissolve",
    "use": "within-section",
    "ms": 600,
    "blend": "crossfade"
   },
   {
    "id": "morph",
    "use": "within-section",
    "ms": 700,
    "morph": true
   },
   {
    "id": "fade-through-paper",
    "use": "section",
    "ms": 820,
    "blend": "via",
    "via_role": "paper"
   }
  ],
  "continuity": {
   "prefer": "morph",
   "first_second_anchor": "a single calm statement of what this explains, on screen at frame 0"
  },
  "caption_style": {
   "font_px": 34,
   "weight": 500,
   "max_lines": 2,
   "max_marks": 2,
   "overflow": "truncate",
   "position": "bottom-center",
   "width_pct": 70,
   "text": {
    "role": "ink"
   },
   "scrim": {
    "role": "paper",
    "alpha": 0.94,
    "radius_px": 14,
    "pad_px": 18
   },
   "reveal": "phrase",
   "dim_previous": true,
   "marks": {
    "good": {
     "role": "positive",
     "styles": [
      "underline",
      "weight-700"
     ]
    },
    "bad": {
     "role": "negative",
     "styles": [
      "dotted-underline"
     ]
    },
    "key": {
     "role": "accent",
     "styles": [
      "box"
     ]
    }
   },
   "markup": "\u27e6good:\u2026\u27e7 \u27e6bad:\u2026\u27e7 \u27e6key:\u2026\u27e7 \u2014 spoken form strips the marks"
  },
  "do": [
   "one idea per frame with generous space around it",
   "pair every risk with what to do about it, on the same frame",
   "hold each label at least as long as it takes to read it aloud twice"
  ],
  "dont": [
   "no flashing, shaking or fast cuts",
   "never signal danger by colour alone \u2014 use a symbol and a word",
   "no dense tables on screen; show the one row that matters"
  ],
  "invented": true,
  "reason": "bends a calm kit into a tide-gauge board: square-ish corners, heavier connector strokes and a wider grid gutter so stacked rungs read as one ladder; no catalog kit combines these"
 },
 "palette": {
  "family": "invented:orchid-parchment",
  "invented": true,
  "reason": "an orchid accent on a warm parchment paper: no catalog family pairs a magenta-violet focal colour with a tinted paper, and the subject (retry storms) wants an alarm colour that is not the red already used for failure",
  "roles": {
   "paper": "#fef6e7",
